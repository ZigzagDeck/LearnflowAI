# Future frontend configuration (placeholders only)
VITE_API_BASE_URL=http://localhost:8000

# Local backend configuration (placeholders only)
APP_ENV=development
LEARNFLOW_MAX_UPLOAD_SIZE_MB=100
LEARNFLOW_DATABASE_PATH=backend/data/learnflow.db
LEARNFLOW_UPLOAD_DIR=backend/uploads
LEARNFLOW_WORKER_POLL_SECONDS=1
LEARNFLOW_JOB_STALE_SECONDS=900
LEARNFLOW_OCR_PROVIDER=google_document_ai
LEARNFLOW_OCR_LOCAL_FALLBACK_ENABLED=false
LEARNFLOW_GOOGLE_OCR_MONTHLY_PAGE_LIMIT=1000
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=replace-with-processor-id
# Point to an untracked service-account JSON file for local development.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the\repo\service-account.json
# Hosting alternative: store the complete JSON as a secret, never in this file.
LEARNFLOW_GOOGLE_SERVICE_ACCOUNT_JSON=
LEARNFLOW_EMBEDDING_PROVIDER=voyage
LEARNFLOW_EMBEDDING_LOCAL_FALLBACK_ENABLED=false
# Store the real value only in an untracked local environment or hosting secret.
VOYAGE_API_KEY=
LEARNFLOW_VOYAGE_EMBEDDING_MODEL=voyage-4-lite
LEARNFLOW_VOYAGE_EMBEDDING_DIMENSIONS=256
LEARNFLOW_VOYAGE_EMBEDDING_BATCH_SIZE=32
LEARNFLOW_VOYAGE_MONTHLY_TOKEN_LIMIT=10000000
# Settings below apply only to the optional local FastEmbed provider/fallback.
LEARNFLOW_MODEL_CACHE_DIR=backend/data/models
LEARNFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LEARNFLOW_EMBEDDING_THREADS=1
LEARNFLOW_EMBEDDING_BATCH_SIZE=4
LEARNFLOW_MIN_EMBEDDING_FREE_MB=768
