# Future frontend configuration (placeholders only)
VITE_API_BASE_URL=http://localhost:8000

# Local backend configuration (placeholders only)
APP_ENV=development
LEARNFLOW_MAX_UPLOAD_SIZE_MB=100
LEARNFLOW_DATABASE_PATH=backend/data/learnflow.db
LEARNFLOW_UPLOAD_DIR=backend/uploads
LEARNFLOW_WORKER_POLL_SECONDS=1
LEARNFLOW_JOB_STALE_SECONDS=900
LEARNFLOW_MODEL_CACHE_DIR=backend/data/models
LEARNFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LEARNFLOW_EMBEDDING_THREADS=1
LEARNFLOW_EMBEDDING_BATCH_SIZE=4
LEARNFLOW_MIN_EMBEDDING_FREE_MB=768
